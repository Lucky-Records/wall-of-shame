# Twitch Helix (required for real Twitch profile ingest).
# Create an app at https://dev.twitch.tv/console/apps
# Client Credentials need a matching Client ID + Secret pair.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# X/Twitter: no API keys required (FxTwitter + unavatar fallback).

# Discord OAuth + role-gated editing
# Create an app at https://discord.com/developers/applications
# OAuth2 → Redirects: add http://localhost:5173/api/auth/callback (and your prod URL)
# Scopes used: identify, guilds, guilds.members.read
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: Bot token fallback if guilds.members.read is unavailable
DISCORD_BOT_TOKEN=
# Server (guild) snowflake — enable Developer Mode in Discord → right-click server → Copy Server ID
DISCORD_GUILD_ID=
# Role snowflake — right-click the editor role → Copy Role ID
DISCORD_EDITOR_ROLE_ID=
# Long random string used to sign session cookies (e.g. openssl rand -hex 32)
SESSION_SECRET=
# Public origin for OAuth redirect_uri
# Local: http://localhost:5173
# Production: https://wall-of-shame-20h.pages.dev
APP_ORIGIN=http://localhost:5173
