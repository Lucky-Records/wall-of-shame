# Twitch Helix (required for real Twitch profile ingest).
# Create an app at https://dev.twitch.tv/console/apps
# Client Credentials need a matching Client ID + Secret pair.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# X/Twitter: no API keys required (FxTwitter + unavatar fallback).

# Optional public origin
# Local: http://localhost:5173
# Production: https://wall-of-shame-20h.pages.dev
APP_ORIGIN=http://localhost:5173

# Discord OAuth is optional/legacy (editing is fully public).
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# SESSION_SECRET=
